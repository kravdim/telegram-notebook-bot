llm:
  # One deadline for the complete main/retry/fallback chain.
  total_timeout_sec: 50
  main:
    provider: minimax
    model: MiniMax-M2.7
    base_url: https://api.minimax.io/v1
    timeout_sec: 25
    max_retries: 2

embedding:
  provider: ollama  # или "cloud"
  model: nomic-embed-text
  base_url: http://localhost:11434
  dimensions: 768

stt:
  provider: local_whisper  # или "groq", "openai"
  model: medium
  language: ru
  # Модель должна быть загружена при установке; runtime не зависает на сети.
  local_files_only: true
  warmup_timeout_sec: 120
  timeout_sec: 90

export:
  # Консервативный предел архива; экспорт создаётся на диске и удаляется после отправки.
  max_bytes: 47185920

bot:
  admin_telegram_ids: []
  allowed_telegram_ids: []
  default_timezone: Europe/Moscow

testing:
  # Только выделенные тестовые аккаунты: cleanup удаляет все их доменные данные.
  e2e_user_ids: []

scheduler:
  healthcheck_interval_min: 5
  sweep_interval_min: 5
  backup_hour: 3
  backup_retention_days: 30
  llm_log_retention_days: 90

slo:
  # Alert when the oldest due reminder or last successful backup exceeds target.
  reminder_lag_seconds: 120
  backup_max_age_hours: 30
  stt_latency_seconds: 30

chronometry:
  default_interval_min: 60
  onboarding_week1_interval: 60
  onboarding_week2_interval: 30
  target_interval: 15
  ignore_threshold: 3

search:
  semantic_weight: 0.6
  text_weight: 0.4
  top_k: 5

context:
  max_tokens: 3000
  keep_recent_pairs: 5

privacy:
  # Не хранить пользовательские тексты и ответы модели в LLM-логах.
  store_llm_payloads: false
