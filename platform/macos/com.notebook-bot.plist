<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.notebook-bot</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT_PATH__/platform/macos/run.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROJECT_PATH__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/notebook-bot/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/notebook-bot/stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONPATH</key>
        <string>__PROJECT_PATH__</string>
        <key>HTTP_PROXY</key>
        <string>http://127.0.0.1:1081</string>
        <key>HTTPS_PROXY</key>
        <string>http://127.0.0.1:1081</string>
        <key>ALL_PROXY</key>
        <string>socks5://127.0.0.1:1080</string>
    </dict>
</dict>
</plist>
