[Unit]
Description=Telegram Notebook Bot
After=network.target postgresql.service

[Service]
Type=simple
User=notebook
Group=notebook
WorkingDirectory=/opt/notebook-bot
ExecStart=/opt/notebook-bot/.venv/bin/python -m bot.main
Restart=always
RestartSec=10
Environment=PYTHONPATH=/opt/notebook-bot

[Install]
WantedBy=multi-user.target
