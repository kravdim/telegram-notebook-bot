# Telegram
BOT_TOKEN=your_telegram_bot_token
# Только для локальной разработки. В production оставьте false.
ALLOW_ALL_USERS=false

# LLM API Keys
MINIMAX_API_KEY=...

# STT (для VPS)
# GROQ_API_KEY=...
# OPENAI_API_KEY=...

# Database
DATABASE_URL=postgresql+asyncpg://notebook:password@127.0.0.1:55432/notebook_bot
# Обязателен для Docker Compose; используйте длинный случайный пароль без :/@.
POSTGRES_PASSWORD=replace_with_a_long_random_password
# BACKUP_DIR=/var/lib/notebook-bot/backups

# Embedding (для VPS, если cloud)
# EMBEDDING_API_KEY=...
# EMBEDDING_BASE_URL=...
